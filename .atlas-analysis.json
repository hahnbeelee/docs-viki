  "keyFeatures": [
    "Business search by keyword, location, category, and price level",
    "Rich business data including ratings, reviews, hours, and photos",
    "Fusion AI API for conversational natural-language business discovery",
    "AI-assisted restaurant reservations via conversational chat",
    "GraphQL API for flexible, customized data queries",
    "Advertising management APIs for CPC, branded profiles, and sponsored listings",
    "Leads API for receiving and responding to Request-a-Quote messages",
    "Reporting API for business metrics and advertiser performance data",
    "Webhooks for real-time event notifications",
    "Partner Feeds for bulk daily business data via S3",
    "Conversions API for offline/online attribution reporting",
    "Reservations API for native booking flows",
    "Business Subscriptions API for unified location management",
    "Data Ingestion API for bulk business listing updates"
  ],
